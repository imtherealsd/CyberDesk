# Safe to expose in browser when paired with RLS. Use the Supabase publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never prefix this with NEXT_PUBLIC_ and never commit a real value.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Server-only. Required for authenticated case persistence and private Storage uploads; never expose this as NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# Local Playwright-only simulated identity. Keep disabled and unset in deployed environments.
CYBERDESK_TEST_AUTH=0
NEXT_PUBLIC_CYBERDESK_TEST_AUTH=0
CYBERDESK_FORCE_LOCAL_STORE=0
